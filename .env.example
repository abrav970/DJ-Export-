# Where quotation enquiries should be delivered.
# The /api/quote route currently logs submissions server-side; wire these up to
# an email provider, CRM or webhook when the client's endpoints are ready.
QUOTE_NOTIFICATION_EMAIL=
# SMTP used to email each enquiry to QUOTE_NOTIFICATION_EMAIL.
# Gmail: host smtp.gmail.com, port 465, user = the Gmail address, pass = an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
QUOTE_WEBHOOK_URL=
NEXT_PUBLIC_SITE_URL=https://www.djexportglobal.com
